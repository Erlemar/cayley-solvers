[Unit]
Description=IHES ranked q64 exact length-22 search
Wants=network-online.target
After=network-online.target google-guest-agent.service

[Service]
Type=simple
CPUQuota=6400%
ExecStartPre=/bin/systemctl set-property --runtime google-startup-scripts.service CPUQuota=100%
ExecStart=/usr/bin/python3 -u /opt/work/scripts/24_twsearch_ladder.py --baseline /opt/work/data/base_21870.csv --journal /opt/work/ladder/q64_L22_ranked_20260805.jsonl --out /tmp/q64_L22_ranked_20260805.csv --full-path-any --parity even --min-path-length 22 --max-path-length 22 --min-depth 20 --max-depth 20 --pid-order-file /opt/work/data/twsearch_rank_L22_20260805.json --exe /opt/work/tws/build/bin/twsearch --tws /opt/work/data/picture_cube_pieces_v2_sym.tws --cache-dir /opt/work/cache64q --memory-mib 65536 --threads 64 --start-prune-depth 12 --time-limit 5400 --resume
StandardOutput=append:/opt/work/logs/q64_L22_ranked_20260805.log
StandardError=append:/opt/work/logs/q64_L22_ranked_20260805.log
Restart=on-failure
RestartSec=30

[Install]
WantedBy=multi-user.target
