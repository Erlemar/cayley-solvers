# Dataset staging dirs (used for Kaggle Datasets pushes)
.dataset_stage_*/
az_recipe_workdir/

# Data dir: drop heavy artifacts but keep small reference JSONs / fallback table
data/*.pkl
data/*.pt
data/*.npy
data/*.npz
data/community_subs/
data/sample_fallback.csv
data/sample_submission.csv
data/test.csv
data/bfs_table_d6_build.log
# megaminx data is entirely binary/intermediate
megaminx/data/

# Misc scratch
/tmp/
nohup.out
*.swp

# cube444 generated artifacts
# ~70 MB of hkociemba pruning tables, regenerable in ~30 min
cube444/data/twophase_tables/
cube444/data/lower_bounds.csv
cube444/logs/

# --- added 2026-08-24 when auditing "commit all new files" ---

# Backups of local settings — settings.local.json holds the Kaggle token, and the
# bare-name rule above does NOT cover a .bak suffix. This is the one that nearly
# committed live credentials.
.claude/settings.local.json*
*.bak

